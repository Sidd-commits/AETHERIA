# AETHERIA Backend Environment Configuration
NODE_ENV=development
PORT=5000
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:8080

# Optional Server-Side AI API Key (never shared publicly, never exposed to client bundles)
# If left empty, AETHERIA uses high-speed local deterministic natural-language heuristics.
OPENAI_API_KEY=
RATE_LIMIT_MAX_REQUESTS_PER_MINUTE=120
