# ==============================================================================
# AETHERIA Environment Configuration
# ==============================================================================

# Application Environment Mode ('development' | 'production' | 'test')
VITE_APP_ENV=development

# Structured Logger Minimum Severity Level ('DEBUG' | 'INFO' | 'WARN' | 'ERROR' | 'NONE')
VITE_LOG_LEVEL=INFO

# Default Initial Active Particle Count (Range: 1000 - 30000, Default: 10000)
VITE_DEFAULT_PARTICLE_COUNT=10000

# Enable Voice Recognition & Ambient Speech Processing ('true' | 'false')
VITE_ENABLE_AI_VOICE=true

# Optional: OpenAI API Key for Enhanced Cloud Natural Language Reasoning
# If left empty, AETHERIA automatically utilizes the built-in zero-latency local NLP heuristic engine.
VITE_OPENAI_API_KEY=
